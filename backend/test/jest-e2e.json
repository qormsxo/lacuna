{
  "moduleFileExtensions": [
    "js",
    "json",
    "ts"
  ],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": [
      "ts-jest",
      {
        "tsconfig": {
          "allowJs": true
        },
        "diagnostics": {
          "ignoreCodes": [
            "TS151001"
          ]
        }
      }
    ]
  },
  "transformIgnorePatterns": [
    "node_modules/(?!@nestjs/schedule/)"
  ],
  "setupFiles": [
    "<rootDir>/setup-env.ts"
  ]
}
