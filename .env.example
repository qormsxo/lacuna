# Application
NODE_ENV=development
API_PORT=3000
API_PREFIX=api
API_VERSION=1
CORS_ORIGIN=http://localhost:5173
# 비워 두면 인증 없음(로컬 기본). 값을 넣으면 모든 요청에 x-api-key 헤더가 필요하고,
# 프론트엔드에도 같은 값을 VITE_API_KEY로 넣어야 한다. /health는 항상 열림.
API_KEY=

# PostgreSQL (local by default)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=lacuna

# TypeORM
# 로컬 개발은 synchronize=true가 편하다. 운영/공유 DB는 synchronize=false + 마이그레이션을 쓴다.
#   빈 DB:                    TYPEORM_MIGRATIONS_RUN=true (또는 npm run migration:run)
#   synchronize로 만든 기존 DB: npm run migration:baseline 한 번 실행 후 위와 동일
TYPEORM_SYNCHRONIZE=true
TYPEORM_MIGRATIONS_RUN=false
TYPEORM_LOGGING=false
# 서버 시작 시 남은 running 작업 기록을 '중단됨'으로 정리(서버 1대 기준). 같은 DB를 여러 프로세스가 쓰면 false.
STALE_RECOVERY_ON_BOOT=true

# News collection / crawl
NEWS_HTTP_TIMEOUT_MS=15000
NEWS_USER_AGENT=Mozilla/5.0 (compatible; LacunaNewsCollector/0.1; +http://localhost)
NEWS_STORE_FULL_BODY=true
NEWS_CRAWL_CONCURRENCY=2
NEWS_CRAWL_INTERVAL_MS=1000
NEWS_CRAWL_MAX_ATTEMPTS=3
NEWS_CRAWL_RETRY_DELAY_MS=60000
NEWS_SCHEDULE_ENABLED=false
NEWS_COLLECT_CRON=*/15 * * * *
NEWS_CRAWL_CRON=*/5 * * * *
NEWS_SCHEDULE_CRAWL_BATCH_LIMIT=20

# LLM (Gemini via OpenAI-compatible endpoint). Required for fact extraction.
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-3.1-flash-lite
LLM_TEMPERATURE=0
LLM_TIMEOUT_MS=60000
# 429/5xx/타임아웃/빈 응답일 때 지수 백오프로 재시도 (Retry-After 헤더 우선)
LLM_MAX_RETRIES=2
LLM_RETRY_BASE_DELAY_MS=2000
LLM_MAX_BODY_CHARS=12000
LLM_UNMATCHED_EVIDENCE_MODE=review
ANALYSIS_MAX_FACTS_PER_RUN=40
HYPOTHESIS_MAX_FACTS_PER_RUN=40
HYPOTHESIS_MAX_REEVALUATE_CANDIDATES=20

# 분석 파이프라인 자동 실행 (사실 추출 → 관계·검증 → 가설 생성 → 재평가)
PIPELINE_AUTO_ENABLED=false
PIPELINE_CRON=*/30 * * * *
PIPELINE_EXTRACT_LIMIT=10
PIPELINE_REEVALUATE_LIMIT=10

# Frontend (Vite)
VITE_API_BASE_URL=http://localhost:3000/api/v1
# VITE_API_KEY=
